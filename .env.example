# Slack credentials are stored per-user in the database (encrypted).
# Users connect their own Slack workspace via Dashboard > Slack Integration.
# No shared Slack credentials needed in env.

DATABASE_URL=postgresql://user:pass@host:port/db?schema=public
KRUTAI_API_KEY=your_krutai_api_key
KRUTAI_SERVER_URL=http://krut-ai-backend:8000
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ENCRYPTION_KEY=your_32_byte_base64_key_run_openssl_rand_base64_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=your_random_hex_secret_run_openssl_rand_hex_32
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=no-reply@sediment.dev
