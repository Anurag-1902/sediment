# Slack credentials are stored per-user in the database (encrypted).
# Users connect their own Slack workspace via Dashboard > Slack Integration.
# No shared Slack credentials needed in env.

DATABASE_URL=postgresql://user:pass@host:port/db?schema=public
KRUTAI_API_KEY=your_krutai_api_key
KRUTAI_SERVER_URL=http://krut-ai-backend:8000
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ENCRYPTION_KEY=your_32_byte_base64_key_run_openssl_rand_base64_32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEBUG_SECRET=your-debug-secret-here

# Razorpay payment gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: pre-created Razorpay plan IDs (avoids API call on cold start)
# After first deployment, check server logs for "Created plan X → plan_id"
# and add them here:
# RAZORPAY_PLAN_ID_STARTER=plan_xxxx
# RAZORPAY_PLAN_ID_PRO=plan_xxxx
# RAZORPAY_PLAN_ID_BUSINESS=plan_xxxx
