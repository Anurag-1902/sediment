generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  role          String    @default("BUSINESS")

  projects      Project[] @relation("ProjectOwner")
  memberships   ProjectMember[]
  updates       DevUpdate[]
  tasks         Task[]    @relation("AssignedTasks")
  aiQueries     AIQuery[]
  contextLogs   ProjectContextLog[]

  organizationId          String? @map("organization_id")
  ownedOrganizations      Organization[] @relation("OrgOwner")
  organizationMemberships OrganizationMember[]
  sentInvites             OrganizationInvite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AuthOtpRequestPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model AuthOtpRequest {
  id         String                @id @default(cuid())
  identifier String
  purpose    AuthOtpRequestPurpose
  createdAt  DateTime              @default(now())

  @@index([identifier, purpose, createdAt])
  @@map("auth_otp_request")
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  ownerId       String    @map("owner_id")
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade, name: "OrgOwner")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt

  members       OrganizationMember[]
  projects      Project[]
  slackWorkspace SlackWorkspace?
  invites       OrganizationInvite[]

  plan                    String    @default("FREE") @map("plan")
  razorpayCustomerId      String?   @map("razorpay_customer_id")
  razorpaySubscriptionId  String?   @map("razorpay_subscription_id")
  planStartedAt           DateTime? @map("plan_started_at")
  planExpiresAt           DateTime? @map("plan_expires_at")
  autoRenew               Boolean   @default(true) @map("auto_renew")

  @@map("organization")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(EMPLOYEE)
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@map("organization_member")
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("MEMBER")
  token          String       @unique
  invitedById    String       @map("invited_by_id")
  invitedBy      User         @relation(fields: [invitedById], references: [id])
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([token])
  @@index([organizationId])
  @@index([email])
  @@map("organization_invite")
}

enum OrgRole {
  MANAGER
  ADMIN
  DEVELOPER
  HR
  ACCOUNTANT
  FINANCE
  EMPLOYEE
}

enum ProjectRole {
  OWNER
  MEMBER
}

model Project {
  id                String    @id @default(cuid())
  name              String
  description       String?
  contextPlainText  String?   @map("context_plain_text")
  ownerId           String    @map("owner_id")
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade, name: "ProjectOwner")
  organizationId    String    @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slackChannelId    String    @map("slack_channel_id")
  slackChannelName  String    @map("slack_channel_name")
  syncTime          String    @map("sync_time")
  syncTimezone      String    @default("America/New_York") @map("sync_timezone")
  standupPrompt     String    @default("What did you do yesterday? What's on today? Any blockers?") @map("standup_prompt")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  members           ProjectMember[]
  syncSessions      SyncSession[]
  tasks             Task[]
  aiQueries         AIQuery[]
  contextLogs       ProjectContextLog[]

  @@map("project")
}

model ProjectMember {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?     @map("user_id")
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  slackUserId   String      @map("slack_user_id")
  slackHandle   String?     @map("slack_handle")
  role          String      @default("MEMBER")

  @@unique([projectId, slackUserId])
  @@map("project_member")
}

enum SyncSessionStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model SyncSession {
  id              String            @id @default(cuid())
  projectId       String            @map("project_id")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime          @map("scheduled_at")
  slackMessageTs  String?           @map("slack_message_ts")
  status          SyncSessionStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")

  updates         DevUpdate[]
  followUps       FollowUp[]

  @@map("sync_session")
}

model DevUpdate {
  id              String      @id @default(cuid())
  sessionId       String      @map("session_id")
  session         SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  slackUserId     String      @map("slack_user_id")
  slackMessageTs  String      @map("slack_message_ts")
  rawText         String      @map("raw_text")
  aiSummary       String?     @map("ai_summary")
  tasks           Json?
  createdAt       DateTime    @default(now()) @map("created_at")

  tasksCreated    Task[]      @relation("CreatedFromUpdate")

  @@map("dev_update")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  CLOSED
}

model Task {
  id                  String      @id @default(cuid())
  projectId           String      @map("project_id")
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description         String
  status              TaskStatus  @default(OPEN)
  assignedToUserId    String?     @map("assigned_to_user_id")
  assignedTo          User?       @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull, name: "AssignedTasks")
  assigneeSlackId     String?     @map("assignee_slack_id")
  assigneeName        String?     @map("assignee_name")
  lastMentionedAt     DateTime?   @map("last_mentioned_at")
  createdFromUpdateId String?     @map("created_from_update_id")
  createdFromUpdate   DevUpdate?  @relation(fields: [createdFromUpdateId], references: [id], onDelete: SetNull, name: "CreatedFromUpdate")
  createdAt           DateTime    @default(now()) @map("created_at")

  followUps           FollowUp[]

  @@map("task")
}

model FollowUp {
  id              String      @id @default(cuid())
  taskId          String      @map("task_id")
  task            Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sessionId       String      @map("session_id")
  session         SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sentAt          DateTime    @default(now()) @map("sent_at")
  slackMessageTs  String?     @map("slack_message_ts")
  respondedAt     DateTime?   @map("responded_at")
  responseText    String?     @map("response_text")

  @@map("follow_up")
}

model AIQuery {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  contextUsed Json?     @map("context_used")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("ai_query")
}

model ProjectContextLog {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updateType  String    @map("update_type")
  oldContext  String?   @map("old_context")
  newContext  String    @map("new_context")
  updatedBy   String    @map("updated_by")
  updater     User      @relation(fields: [updatedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("project_context_log")
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  count       Int      @default(0)
  windowStart DateTime @default(now()) @map("window_start")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("rate_limit")
}

model SlackWorkspace {
  id               String       @id @default(cuid())
  organizationId   String       @unique @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceName    String       @map("workspace_name")
  workspaceId      String?      @map("workspace_id")
  clientIdEnc      String       @map("client_id_enc")
  clientSecretEnc  String       @map("client_secret_enc")
  signingSecretEnc String       @map("signing_secret_enc")
  botTokenEnc      String       @map("bot_token_enc")
  botUserId        String?      @map("bot_user_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("slack_workspaces")
}

model DebugEvent {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("debug_events")
}
